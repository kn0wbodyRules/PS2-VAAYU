# Copy to .env and fill in. .env is gitignored; never commit real keys.

# https://explore.openaq.org/register -> API key
OPENAQ_API_KEY=

# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# https://data.gov.in (backup live AQI feed)
DATAGOVIN_API_KEY=

# Copernicus Atmosphere Data Store (CAMS): https://ads.atmosphere.copernicus.eu/profile
# Accept the CAMS global forecast dataset licence on the website once before first use.
ADS_URL=https://ads.atmosphere.copernicus.eu/api
ADS_KEY=

# Optional overrides
# VAAYU_DRIVE_ROOT=G:/My Drive/PS2-VAAYU
# VAAYU_MET_BASELINE=cams
