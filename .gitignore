# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Environments
venv/
.venv/

# Data / model artefacts must live on Google Drive, never in the repo.
# Anchored to the repo root so a frontend's src/data/ or src/models/ is NOT ignored.
/data/
/models/
/logs/
*.parquet
*.nc
*.grib
*.pt
*.pth
*.ckpt
/*.zip
/*.csv

# Frontend (Node) - dependencies and build output are regenerated, never committed
node_modules/
frontend/dist/
frontend/build/
frontend/.next/

# Notebook / editor noise
.ipynb_checkpoints/
.vscode/
.idea/
